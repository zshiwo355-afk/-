{
  "tokenhub_api_key": "",
  "tokenhub_base_url": "https://tokenhub.tencentmaas.com/v1",
  "model": "hy-mt2-pro",
  "default_target_language": "简体中文",
  "temperature": 0.1,
  "stream": false,
  "chunk_size_chars": 3500,
  "max_retries": 3,
  "request_timeout_seconds": 180,
